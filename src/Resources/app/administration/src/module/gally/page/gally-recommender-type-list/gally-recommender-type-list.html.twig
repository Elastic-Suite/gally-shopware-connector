{% block gally_recommender_type_list %}
<sw-page class="gally-recommender-type-list">
    {% block gally_recommender_type_list_smart_bar_header %}
        <template #smart-bar-header>
            <h2>{{ $tc('gally.recommenderType.list.title') }}</h2>
        </template>
    {% endblock %}

    {% block gally_recommender_type_list_smart_bar_actions %}
        <template #smart-bar-actions>
            <sw-button variant="primary" @click="onAdd">
                {{ $tc('gally.recommenderType.list.buttonAdd') }}
            </sw-button>
        </template>
    {% endblock %}

    {% block gally_recommender_type_list_content %}
        <template #content>
            <sw-entity-listing
                v-if="items"
                :items="items"
                :repository="repository"
                :columns="columns"
                :allowInlineEdit="true"
                :showSelection="false"
                detailRoute="gally.plugin.recommenderTypeDetail"
                @inline-edit-save="onInlineEditSave"
            ></sw-entity-listing>
        </template>
    {% endblock %}
</sw-page>
{% endblock %}
