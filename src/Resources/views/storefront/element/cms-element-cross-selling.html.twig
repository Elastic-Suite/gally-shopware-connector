{% sw_extends '@Storefront/storefront/element/cms-element-cross-selling.html.twig' %}

{# Gally recommendation blocks (see ProductRecommendationSubscriber) are shown as extra tabs,
   ahead of the native cross-selling groups, using the exact same tab/slider markup so they're
   visually indistinguishable from native Shopware cross-selling.
   The whole tabs_inner block is re-implemented (rather than delegated to {{ parent() }}) because
   which native tab/pane gets the "active" class depends on whether any Gally tab precedes it -
   core's own block has no such parameter, and Twig blocks can't take one. The one native-only
   sub-block core exposes for per-item customization, cms_element_cross_selling_tabs_content_
   container_slider, is kept under the exact same name below so a third-party plugin already
   extending it for native cross-selling still works once Gally is installed. #}

{% block cms_element_cross_selling_tabs_inner %}
    {% if not sliderConfig %}
        {% set sliderConfig = element.fieldConfig.elements %}
    {% endif %}

    {% set gallyRecommendations = page.getExtension('gallyRecommendations') %}
    {% set gallyBlocks = gallyRecommendations ? gallyRecommendations.get('blocks')|filter(b => b.products|length > 0) : [] %}
    {% set nativeItems = element.data.crossSellings.elements is defined ? element.data.crossSellings.elements|filter(item => item.total > 0 and item.crossSelling.active == true) : [] %}

    {% if nativeItems|length > 0 or gallyBlocks|length > 0 %}
        <div class="product-detail-cross-selling">
            <div class="card card-tabs" data-cross-selling="true">
                {% block cms_element_cross_selling_tabs_navigation %}
                    <div class="card-header product-detail-tab-navigation product-cross-selling-tab-navigation">
                        {% block cms_element_cross_selling_tabs_navigation_container %}
                            <ul class="nav nav-tabs product-detail-tab-navigation-list"
                                id="product-detail-cross-selling-tabs"
                                role="tablist">
                                {% for gallyBlock in gallyBlocks %}
                                    <li class="nav-item">
                                        <a class="nav-link product-detail-tab-navigation-link{% if loop.first %} active{% endif %}"
                                           id="cross-selling-tab-gally-{{ gallyBlock.code }}"
                                           data-bs-toggle="tab"
                                           href="#cross-selling-tab-gally-{{ gallyBlock.code }}-pane"
                                           role="tab"
                                           title="{{ gallyBlock.name }}"
                                           aria-controls="cross-selling-tab-gally-{{ gallyBlock.code }}-pane"
                                           aria-selected="true"
                                        >
                                            {{ gallyBlock.name }}
                                            <span class="product-detail-tab-navigation-icon">
                                                {% sw_icon 'arrow-medium-right' style { pack:'solid' } %}
                                            </span>
                                        </a>
                                    </li>
                                {% endfor %}

                                {% for item in nativeItems %}
                                    {% set crossSelling = item.crossSelling %}
                                    {% set id = crossSelling.id %}
                                    <li class="nav-item">
                                        <a class="nav-link product-detail-tab-navigation-link{% if gallyBlocks|length == 0 and loop.first %} active{% endif %}"
                                           id="cross-selling-tab-{{ id }}"
                                           data-bs-toggle="tab"
                                           href="#cross-selling-tab-{{ id }}-pane"
                                           role="tab"
                                           title="{{ crossSelling.translated.name }}"
                                           aria-controls="cross-selling-tab-{{ id }}-pane"
                                           aria-selected="true"
                                        >
                                            {{ crossSelling.translated.name }}
                                            <span class="product-detail-tab-navigation-icon">
                                                {% sw_icon 'arrow-medium-right' style { pack:'solid' } %}
                                            </span>
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endblock %}
                    </div>
                {% endblock %}

                {% block cms_element_cross_selling_tabs_content %}
                    <div class="product-detail-tabs-content card-body">
                        {% block cms_element_cross_selling_tabs_content_container %}
                            <div class="tab-content">
                                {% for gallyBlock in gallyBlocks %}
                                    <div class="tab-pane fade show{% if loop.first %} active{% endif %}"
                                         id="cross-selling-tab-gally-{{ gallyBlock.code }}-pane"
                                         role="tabpanel"
                                         aria-labelledby="cross-selling-tab-gally-{{ gallyBlock.code }}"
                                    >
                                        {% set config = {
                                            title: { value: gallyBlock.name },
                                            border: { value: false },
                                            rotate: { value: false },
                                            products: { value: gallyBlock.products },
                                            boxLayout: { value: sliderConfig.boxLayout.value },
                                            elMinWidth: { value: sliderConfig.elMinWidth.value },
                                            navigation: { value: true },
                                            navigationArrows: { value: 'outside' },
                                            displayMode: { value: sliderConfig.displayMode.value },
                                            verticalAlign: { value: center },
                                            speed: { value: sliderConfig.speed.value },
                                        } %}
                                        {% sw_include '@Storefront/storefront/element/cms-element-product-slider.html.twig' with {
                                            sliderConfig: config,
                                            element: {
                                                data: {
                                                    products: gallyBlock.products,
                                                },
                                                type: 'product-slider',
                                            },
                                        } %}
                                    </div>
                                {% endfor %}

                                {% for item in nativeItems %}
                                    {% set crossSelling = item.crossSelling %}
                                    {% set products = item.products %}
                                    {% set id = crossSelling.id %}
                                    <div class="tab-pane fade show{% if gallyBlocks|length == 0 and loop.first %} active{% endif %}"
                                         id="cross-selling-tab-{{ id }}-pane"
                                         role="tabpanel"
                                         aria-labelledby="cross-selling-tab-{{ id }}"
                                    >
                                        {% set config = {
                                            title: { value: crossSelling.name ?: crossSelling.translated.name },
                                            border: { value: false },
                                            rotate: { value: false },
                                            products: { value: products },
                                            boxLayout: { value: sliderConfig.boxLayout.value },
                                            elMinWidth: { value: sliderConfig.elMinWidth.value },
                                            navigation: { value: true },
                                            navigationArrows: { value: 'outside' },
                                            displayMode: { value: sliderConfig.displayMode.value },
                                            verticalAlign: { value: center },
                                            speed: { value: sliderConfig.speed.value },
                                        } %}
                                        {# Same block name as core's own cms-element-cross-selling.html.twig for this
                                           exact slider include: any third-party plugin already extending it to alter
                                           native cross-selling sliders keeps working once Gally is installed. #}
                                        {% block cms_element_cross_selling_tabs_content_container_slider %}
                                            {% sw_include '@Storefront/storefront/element/cms-element-product-slider.html.twig' with {
                                                sliderConfig: config,
                                                element: {
                                                    data: {
                                                        products: products,
                                                    },
                                                    type: 'product-slider',
                                                },
                                            } %}
                                        {% endblock %}
                                    </div>
                                {% endfor %}
                            </div>
                        {% endblock %}
                    </div>
                {% endblock %}
            </div>
        </div>
    {% endif %}
{% endblock %}
