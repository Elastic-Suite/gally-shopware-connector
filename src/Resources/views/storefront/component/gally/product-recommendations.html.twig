{% block gally_product_recommendations %}
    {% if products and products|length > 0 %}
        <div class="gally-product-recommendations product-detail-cross-selling">
            <div class="card">
                {% block gally_product_recommendations_title %}
                    <div class="card-header">
                        <h2 class="gally-product-recommendations-title h5 mb-0">{{ title }}</h2>
                    </div>
                {% endblock %}

                {% block gally_product_recommendations_content %}
                    <div class="card-body">
                        <div class="row">
                            {% for product in products %}
                                {% block gally_product_recommendations_item %}
                                    <div class="col-sm-6 col-lg-4 col-xl-3">
                                        {% sw_include '@Storefront/storefront/component/product/card/box.html.twig' with {
                                            layout: 'standard',
                                            displayMode: 'standard'
                                        } %}
                                    </div>
                                {% endblock %}
                            {% endfor %}
                        </div>
                    </div>
                {% endblock %}
            </div>
        </div>
    {% endif %}
{% endblock %}
