{% sw_extends '@Storefront/storefront/base.html.twig' %}

{% block base_head %}
    {{ parent() }}
    {% block gally_tracking_queue_stub %}
        {# Defines window.gallyEvent.push as a queue writer before the storefront JS bundle
           (and the real SDK it imports) has had a chance to load, so early per-page tracking
           snippets never call an undefined function. #}
        <script>
            ;(function (w) {
                if (w.gallyEvent) { return; }
                w.gallyEvent = {
                    push: function (item) {
                        try {
                            var raw = localStorage.getItem('gally-event-queue');
                            var queue = raw ? JSON.parse(raw) : [];
                            queue.push(item);
                            localStorage.setItem('gally-event-queue', JSON.stringify(queue));
                        } catch (e) {}
                    }
                };
            })(window);
        </script>
    {% endblock %}
{% endblock %}

{% block base_body_script %}
    {% if gally_is_active(context.salesChannel.id) and gally_is_tracking_active(context.salesChannel.id) %}
        {% block gally_tracking_config %}
            <div data-gally-tracking="true"
                 data-gally-tracking-options="{{ {
                     baseUri: gally_tracking_base_url(),
                     uidCookieMaxAge: 34560000,
                     vidCookieMaxAge: 1800
                 }|json_encode|e('html_attr') }}"></div>
        {% endblock %}
    {% endif %}
    {{ parent() }}
{% endblock %}
