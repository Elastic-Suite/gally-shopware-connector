{% sw_extends '@Storefront/storefront/block/cms-block-cross-selling.html.twig' %}

{# Display gally product recommendations before the native Shopware cross-selling block. #}
{% block block_cross_selling %}
    {% set gallyRecommendations = page.getExtension('gallyRecommendations') %}
    {% if gallyRecommendations and (gallyRecommendations.get('related')|length > 0 or gallyRecommendations.get('upsell')|length > 0) %}
        {% block block_cross_selling_gally_recommendations %}
            <style>
                .gally-product-recommendations .product-name {
                    margin-bottom: 0.25rem;
                }
                .gally-product-recommendations .product-description {
                    margin-bottom: 0.25rem;
                }
                .gally-product-recommendations .product-price-info {
                    margin-top: 0;
                }
                .gally-product-recommendations + .gally-product-recommendations {
                    margin-top: 4rem;
                }
            </style>
            <div class="col-12 gally-recommendations">
                {% sw_include '@GallyPlugin/storefront/component/gally/product-recommendations.html.twig' with {
                    products: gallyRecommendations.get('related'),
                    title: 'gally.recommendation.customersAlsoBought'|trans
                } %}
                {% sw_include '@GallyPlugin/storefront/component/gally/product-recommendations.html.twig' with {
                    products: gallyRecommendations.get('upsell'),
                    title: 'gally.recommendation.youMayAlsoLike'|trans
                } %}
            </div>
        {% endblock %}
    {% endif %}

    {{ parent() }}
{% endblock %}
