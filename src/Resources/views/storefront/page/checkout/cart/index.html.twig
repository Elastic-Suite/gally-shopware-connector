{% sw_extends '@Storefront/storefront/page/checkout/cart/index.html.twig' %}

{% block page_checkout_cart %}
    {{ parent() }}

    {% set gallyRecommendations = page.getExtension('gallyRecommendations') %}
    {% set gallyBlocks = gallyRecommendations ? gallyRecommendations.get('blocks') : [] %}
    {% if gallyBlocks|length > 0 %}
        <div class="col-12 gally-recommendations">
            {% for gallyBlock in gallyBlocks %}
                {% if gallyBlock.products|length > 0 %}
                    {% sw_include '@GallyPlugin/storefront/component/gally/product-recommendations.html.twig' with {
                        products: gallyBlock.products,
                        title: gallyBlock.code|replace({'_': ' ', '-': ' '})|capitalize
                    } %}
                {% endif %}
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
