<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <imports>
        <import resource="services/sdk.xml"/>
        <import resource="services/commands.xml"/>
        <import resource="services/controllers.xml"/>
        <import resource="services/indexers.xml"/>
        <import resource="services/search.xml"/>
        <import resource="services/tracking.xml"/>
    </imports>

    <services>
        <service id="Gally\ShopwarePlugin\Config\ConfigManager" public="true">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService" />
        </service>

        <service id="Gally\ShopwarePlugin\Subscriber\UpdateConfigSubscriber">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService" />
            <argument type="service" id="Gally\ShopwarePlugin\Config\CacheManager" />
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Gally\ShopwarePlugin\Subscriber\ProductRecommendationSubscriber">
            <argument type="service" id="Gally\ShopwarePlugin\Config\ConfigManager" />
            <argument type="service" id="Gally\Sdk\Service\RecommenderManager" />
            <argument type="service" id="Gally\ShopwarePlugin\Indexer\Provider\CatalogProvider" />
            <argument type="service" id="language.repository" />
            <argument type="service" id="sales_channel.product.repository" />
            <argument type="service" id="product.repository" />
            <argument type="service" id="logger" />
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Gally\ShopwarePlugin\Subscriber\CartRecommendationSubscriber">
            <argument type="service" id="Gally\ShopwarePlugin\Config\ConfigManager" />
            <argument type="service" id="Gally\Sdk\Service\RecommenderManager" />
            <argument type="service" id="Gally\ShopwarePlugin\Indexer\Provider\CatalogProvider" />
            <argument type="service" id="language.repository" />
            <argument type="service" id="product.repository" />
            <argument type="service" id="sales_channel.product.repository" />
            <argument type="service" id="logger" />
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Gally\ShopwarePlugin\Twig\GallyExtension">
            <argument type="service" id="Gally\ShopwarePlugin\Config\ConfigManager" />
            <argument type="service" id="router" />
            <argument type="service" id="request_stack" />
            <argument type="service" id="language.repository" />
            <argument type="service" id="Gally\ShopwarePlugin\Indexer\Provider\CatalogProvider" />
            <tag name="twig.extension" />
        </service>
    </services>
</container>
