<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <!-- Dedicated pool: cache.app is an array adapter in dev (never persisted across requests) -->
        <service id="gally.cache" class="Symfony\Component\Cache\Adapter\FilesystemAdapter">
            <argument>gally</argument>
            <argument>0</argument>
            <argument>%kernel.cache_dir%/gally</argument>
        </service>
        <service id="Gally\ShopwarePlugin\Config\CacheManager">
            <call method="setCache">
                <argument type="service" id="gally.cache" />
            </call>
        </service>
        <service id="Gally\Sdk\Client\Configuration" lazy="true">
            <factory class="Gally\ShopwarePlugin\Factory\ConfigurationFactory" method="create"/>
            <argument type="service" id="Gally\ShopwarePlugin\Config\ConfigManager" />
        </service>
        <service id="Gally\Sdk\Service\BundleManager">
            <argument type="service" id="Gally\Sdk\Client\Configuration" />
            <argument type="service" id="Gally\ShopwarePlugin\Config\CacheManager" />
        </service>
        <service id="Gally\Sdk\Service\StructureSynchonizer">
            <argument type="service" id="Gally\Sdk\Client\Configuration" />
            <argument type="service" id="Gally\ShopwarePlugin\Config\CacheManager" />
        </service>
        <service id="Gally\Sdk\Service\IndexOperation">
            <argument type="service" id="Gally\Sdk\Client\Configuration" />
            <argument type="service" id="Gally\ShopwarePlugin\Config\CacheManager" />
        </service>
        <service id="Gally\Sdk\Service\SearchManager">
            <argument type="service" id="Gally\Sdk\Client\Configuration" />
            <argument type="service" id="Gally\Sdk\Service\BundleManager" />
            <argument type="service" id="Gally\ShopwarePlugin\Config\CacheManager" />
        </service>
        <service id="Gally\Sdk\Service\RecommenderManager">
            <argument type="service" id="Gally\Sdk\Client\Configuration" />
            <argument type="service" id="Gally\ShopwarePlugin\Config\CacheManager" />
        </service>
        <service id="Gally\ShopwarePlugin\Service\RecommenderTypeCatalog">
            <argument type="service" id="Gally\Sdk\Client\Configuration" />
            <argument type="service" id="Gally\ShopwarePlugin\Config\CacheManager" />
        </service>
    </services>
</container>
