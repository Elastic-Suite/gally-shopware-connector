<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="Gally\ShopwarePlugin\Service\TrackingProxyService">
            <argument type="service" id="Gally\ShopwarePlugin\Config\ConfigManager" />
            <argument type="service" id="logger" />
            <argument type="service" id="http_client" />
        </service>

        <service id="Gally\ShopwarePlugin\Controller\TrackingController" public="true">
            <argument type="service" id="Gally\ShopwarePlugin\Service\TrackingProxyService" />
            <argument type="service" id="Gally\ShopwarePlugin\Service\RecommendationHelper" />
            <tag name="controller.service_arguments" />
        </service>
    </services>
</container>
